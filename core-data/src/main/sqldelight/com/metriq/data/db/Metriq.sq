-- Local-only schema. All state lives on the device.

CREATE TABLE profile (
  id INTEGER PRIMARY KEY CHECK (id = 1),
  sex TEXT NOT NULL,
  age INTEGER NOT NULL,
  heightCm REAL NOT NULL,
  weightKg REAL NOT NULL,
  bodyFatPercent REAL,
  activity TEXT NOT NULL,
  goal TEXT NOT NULL,
  diet TEXT NOT NULL,
  proteinTier TEXT NOT NULL,
  targetWeightKg REAL,
  createdAt INTEGER NOT NULL
);

CREATE TABLE weightEntry (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  date TEXT NOT NULL UNIQUE,
  kg REAL NOT NULL,
  source TEXT NOT NULL DEFAULT 'manual',
  note TEXT
);

CREATE INDEX weightEntry_date ON weightEntry(date);

CREATE TABLE food (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source TEXT NOT NULL,
  sourceId TEXT,
  barcode TEXT,
  name TEXT NOT NULL,
  brand TEXT,
  category TEXT,
  iconId TEXT,
  calories REAL NOT NULL,
  protein REAL NOT NULL,
  fat REAL NOT NULL,
  carbs REAL NOT NULL,
  fiber REAL,
  sugar REAL,
  sodium REAL,
  servingLabel TEXT,
  servingGrams REAL,
  verified INTEGER NOT NULL DEFAULT 0,
  isCustom INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX food_barcode ON food(barcode) WHERE barcode IS NOT NULL;

-- Expression index: search uses lower(name), so a plain name index would be useless.
CREATE INDEX food_name_lower ON food(lower(name));


CREATE TABLE logEntry (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  date TEXT NOT NULL,
  hour INTEGER NOT NULL,
  foodId INTEGER NOT NULL REFERENCES food(id),
  grams REAL NOT NULL,
  servings REAL NOT NULL DEFAULT 1,
  createdAt INTEGER NOT NULL
);

CREATE INDEX logEntry_date ON logEntry(date);

CREATE TABLE recipe (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  servings INTEGER NOT NULL,
  totalGrams REAL NOT NULL,
  note TEXT
);

CREATE TABLE recipeItem (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  recipeId INTEGER NOT NULL REFERENCES recipe(id),
  foodId INTEGER NOT NULL REFERENCES food(id),
  grams REAL NOT NULL
);

CREATE TABLE dayProperty (
  date TEXT PRIMARY KEY,
  onPeriod INTEGER NOT NULL DEFAULT 0,
  fasting INTEGER NOT NULL DEFAULT 0,
  note TEXT
);

CREATE TABLE bodyMeasurement (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  date TEXT NOT NULL,
  site TEXT NOT NULL,
  valueCm REAL NOT NULL
);

CREATE INDEX bodyMeasurement_date ON bodyMeasurement(date);

CREATE TABLE progressPhoto (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  date TEXT NOT NULL,
  path TEXT NOT NULL,
  pose TEXT,
  note TEXT
);

CREATE INDEX progressPhoto_date ON progressPhoto(date);

CREATE TABLE habit (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  schedule TEXT NOT NULL,
  color TEXT NOT NULL,
  archived INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE habitLog (
  habitId INTEGER NOT NULL REFERENCES habit(id),
  date TEXT NOT NULL,
  done INTEGER NOT NULL DEFAULT 1,
  PRIMARY KEY (habitId, date)
);

CREATE INDEX habitLog_date ON habitLog(date);

CREATE TABLE stepEntry (
  date TEXT PRIMARY KEY,
  steps INTEGER NOT NULL,
  source TEXT NOT NULL DEFAULT 'manual'
);

CREATE TABLE waterEntry (
  date TEXT PRIMARY KEY,
  ml INTEGER NOT NULL
);

CREATE TABLE nutrientTarget (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nutrient TEXT NOT NULL UNIQUE,
  mode TEXT NOT NULL,
  minimum REAL,
  maximum REAL,
  effectiveFrom TEXT NOT NULL
);

CREATE TABLE program (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  style TEXT NOT NULL,
  startDate TEXT NOT NULL,
  weeklyKcal REAL NOT NULL,
  targetRatePercent REAL NOT NULL,
  split TEXT
);

CREATE TABLE checkin (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  weekStart TEXT NOT NULL UNIQUE,
  recommendedKcal REAL NOT NULL,
  recommendedMacros TEXT NOT NULL,
  accepted INTEGER NOT NULL DEFAULT 0,
  note TEXT
);

CREATE TABLE settings (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE exportJob (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  scope TEXT NOT NULL,
  rangeStart TEXT NOT NULL,
  rangeEnd TEXT NOT NULL,
  format TEXT NOT NULL,
  path TEXT NOT NULL,
  createdAt INTEGER NOT NULL
);

CREATE TABLE aiRequest (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  kind TEXT NOT NULL,
  model TEXT NOT NULL,
  tokens INTEGER NOT NULL,
  latencyMs INTEGER NOT NULL,
  local INTEGER NOT NULL,
  createdAt INTEGER NOT NULL
);

-- profile
selectProfile:
SELECT * FROM profile WHERE id = 1;

upsertProfile:
INSERT OR REPLACE INTO profile(id, sex, age, heightCm, weightKg, bodyFatPercent, activity, goal, diet, proteinTier, targetWeightKg, createdAt)
VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- weights
selectWeights:
SELECT * FROM weightEntry ORDER BY date ASC;

insertWeight:
INSERT OR REPLACE INTO weightEntry(date, kg, source, note) VALUES (?, ?, ?, ?);

deleteWeight:
DELETE FROM weightEntry WHERE date = ?;

-- food and search
countFood:
SELECT COUNT(*) AS count FROM food;

insertFood:
INSERT INTO food(source, sourceId, barcode, name, brand, category, iconId, calories, protein, fat, carbs, fiber, sugar, sodium, servingLabel, servingGrams, verified, isCustom)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertOnlineFood:
INSERT INTO food(source, sourceId, barcode, name, brand, category, iconId, calories, protein, fat, carbs, fiber, sugar, sodium, servingLabel, servingGrams, verified, isCustom)
VALUES ('online', ?, ?, ?, ?, ?, NULL, ?, ?, ?, ?, NULL, NULL, NULL, ?, ?, 0, 0);

foodByNameBrand:
SELECT * FROM food WHERE name = ? AND COALESCE(brand, '') = ? LIMIT 1;

recentFood:
SELECT * FROM food ORDER BY id DESC LIMIT ?;

firstFoods:
SELECT * FROM food WHERE source = 'base' ORDER BY id ASC LIMIT ?;

selectAllFoodIds:
SELECT id, name, brand, category FROM food ORDER BY id;

foodByBarcode:
SELECT * FROM food WHERE barcode = ? LIMIT 1;

foodById:
SELECT * FROM food WHERE id = ?;

insertCustomFood:
INSERT INTO food(source, sourceId, barcode, name, brand, category, iconId, calories, protein, fat, carbs, fiber, sugar, sodium, servingLabel, servingGrams, verified, isCustom)
VALUES ('custom', NULL, NULL, ?, ?, 'custom', NULL, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, 1);

-- isCustom guard: a seed/online row must never be overwritten by the custom-food editor.
updateCustomFood:
UPDATE food SET name = ?, brand = ?, calories = ?, protein = ?, fat = ?, carbs = ?,
  fiber = ?, sugar = ?, sodium = ?, servingLabel = ?, servingGrams = ?
WHERE id = ? AND isCustom = 1;

-- log
insertLogEntry:
INSERT INTO logEntry(date, hour, foodId, grams, servings, createdAt) VALUES (?, ?, ?, ?, ?, ?);

deleteLogEntry:
DELETE FROM logEntry WHERE id = ?;

updateLogGrams:
UPDATE logEntry SET grams = ? WHERE id = ?;

logsForDate:
SELECT logEntry.id AS id, logEntry.date AS date, logEntry.hour AS hour,
       logEntry.grams AS grams, logEntry.servings AS servings,
       food.id AS foodId, food.name AS name, food.brand AS brand, food.iconId AS iconId,
       food.calories AS calories, food.protein AS protein, food.fat AS fat, food.carbs AS carbs
FROM logEntry JOIN food ON food.id = logEntry.foodId
WHERE logEntry.date = ? ORDER BY logEntry.hour ASC, logEntry.id ASC;

copyLogToDate:
INSERT INTO logEntry(date, hour, foodId, grams, servings, createdAt)
SELECT ?, hour, foodId, grams, servings, ? FROM logEntry WHERE date = ?;

deleteLogsForDate:
DELETE FROM logEntry WHERE date = ?;

dailyIntake:
SELECT logEntry.date AS date, SUM(food.calories * logEntry.grams / 100.0 * logEntry.servings) AS kcal
FROM logEntry JOIN food ON food.id = logEntry.foodId
GROUP BY logEntry.date ORDER BY date;

-- day properties
dayPropertyForDate:
SELECT * FROM dayProperty WHERE date = ?;

upsertDayProperty:
INSERT OR REPLACE INTO dayProperty(date, onPeriod, fasting, note) VALUES (?, ?, ?, ?);

-- settings
settingValue:
SELECT value FROM settings WHERE key = ?;

setSetting:
INSERT OR REPLACE INTO settings(key, value) VALUES (?, ?);

-- steps and water
insertSteps:
INSERT OR REPLACE INTO stepEntry(date, steps, source) VALUES (?, ?, ?);

latestCheckin:
SELECT * FROM checkin ORDER BY weekStart DESC LIMIT 1;

checkinForWeek:
SELECT * FROM checkin WHERE weekStart = ? ORDER BY id DESC LIMIT 1;

insertCheckin:
INSERT INTO checkin(weekStart, recommendedKcal, recommendedMacros, accepted, note) VALUES (?, ?, ?, ?, ?);

deleteCheckinForWeek:
DELETE FROM checkin WHERE weekStart = ?;

stepsForDate:
SELECT steps FROM stepEntry WHERE date = ?;

insertWater:
INSERT OR REPLACE INTO waterEntry(date, ml) VALUES (?, ?);

waterForDate:
SELECT ml FROM waterEntry WHERE date = ?;

